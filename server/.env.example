NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/firmflow?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Razorpay (Phase 3 billing) ---
# Optional — the app boots fine without these; only paid checkout and
# webhook verification need them. Get keyId/keySecret from Razorpay
# Dashboard > Settings > API Keys (use Test Mode while building).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks, after creating the webhook below.
RAZORPAY_WEBHOOK_SECRET=

# Plan IDs from Dashboard > Subscriptions > Plans — one per (tier, cycle).
# Read by src/scripts/seedPlans.ts; re-run that script after filling these in.
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=
RAZORPAY_PLAN_ENTERPRISE_YEARLY=